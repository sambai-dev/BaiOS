# Required together to enable Ask about Sam. Keep the API key server-only.
OPENROUTER_API_KEY=

# Verified NVIDIA Nemotron 3 Super free model through OpenRouter.
# The route requires a named :free model, caps provider token prices at zero,
# and disables fallback routing. Provider availability and rate limits still apply.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: raises CoinGecko demo API reliability when configured.
COINGECKO_DEMO_API_KEY=

# Optional: use CoinMarketCap's authenticated API instead of its public index API.
COINMARKETCAP_API_KEY=
